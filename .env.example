# ─────────────────────────────────────────────────────────
# GoluPDFs AI SEO OS — Environment Variables Reference
# Copy to .env.local and fill in your real values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# AI Models
GEMINI_API_KEY=replace_with_gemini_key
OPENROUTER_API_KEY=replace_with_openrouter_key

# Admin Authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password
JWT_SECRET=replace_with_64char_random_string

# Automation
CRON_SECRET=replace_with_cron_secret_token

# Alerts & Monitoring
DISCORD_WEBHOOK_URL=replace_with_discord_webhook_url

# Google
GOOGLE_SITE_VERIFICATION=replace_with_gsc_verification_token
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Social Distribution (Optional — add when ready)
DEV_TO_API_KEY=replace_with_devto_key
HASHNODE_TOKEN=replace_with_hashnode_token
MEDIUM_INTEGRATION_TOKEN=replace_with_medium_token
LINKEDIN_ACCESS_TOKEN=replace_with_linkedin_token

# Site Config
NEXT_PUBLIC_SITE_URL=https://golupdf.online
